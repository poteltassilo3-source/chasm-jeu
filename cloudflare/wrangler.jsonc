{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chasm-jeu",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "TOURNOI", "class_name": "Tournoi" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Tournoi"] }]
}
